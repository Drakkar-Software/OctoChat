{
  "name": "octochat",
  "version": "0.0.0",
  "private": true,
  "description": "OctoChat — a universal (web + native) Expo sticker editor, built as a pnpm monorepo.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "start": "pnpm --filter @octochat/mobile start",
    "web": "pnpm --filter @octochat/mobile web",
    "android": "pnpm --filter @octochat/mobile android",
    "ios": "pnpm --filter @octochat/mobile ios",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint"
  }
}
