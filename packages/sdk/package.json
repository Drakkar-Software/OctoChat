{
  "name": "@drakkar.software/octochat-sdk",
  "version": "0.2.0",
  "description": "Headless, reusable OctoChat core — chat-domain logic (identity, encrypted Starfish sync, registry, spaces/rooms, messages, DMs, formatters) with no UI and no platform lock-in.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platform": {
      "react-native": {
        "types": "./dist/platform/index.native.d.ts",
        "default": "./dist/platform/index.native.js"
      },
      "import": {
        "types": "./dist/platform/index.d.ts",
        "default": "./dist/platform/index.js"
      },
      "default": {
        "types": "./dist/platform/index.d.ts",
        "default": "./dist/platform/index.js"
      }
    },
    "./hash-wasm-shim": {
      "types": "./dist/platform/hash-wasm-shim.d.ts",
      "import": "./dist/platform/hash-wasm-shim.js",
      "default": "./dist/platform/hash-wasm-shim.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@drakkar.software/octospaces-sdk": "^0.6.0",
    "@drakkar.software/starfish-client": "3.0.0-alpha.27",
    "@drakkar.software/starfish-identities": "3.0.0-alpha.27",
    "@drakkar.software/starfish-keyring": "3.0.0-alpha.27",
    "@drakkar.software/starfish-protocol": "3.0.0-alpha.27",
    "@drakkar.software/starfish-sharing": "3.0.0-alpha.27",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.0.0",
    "hash-wasm": "^4.12.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "~56.0.4",
    "react-native-quick-crypto": "^1.1.4"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "expo-secure-store": { "optional": true },
    "react-native-quick-crypto": { "optional": true }
  },
  "devDependencies": {
    "@octochat/tsconfig": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/node": "^22.19.19",
    "expo-secure-store": "~56.0.4",
    "react-native-quick-crypto": "^1.1.4",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
