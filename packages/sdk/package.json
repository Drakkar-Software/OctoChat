{
  "name": "@drakkar.software/octochat-sdk",
  "version": "0.1.0",
  "description": "Headless, reusable OctoChat core — chat-domain logic (identity, encrypted Starfish sync, registry, spaces/rooms, messages, DMs, formatters) with no UI and no platform lock-in.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@drakkar.software/starfish-client": "3.0.0-alpha.21",
    "@drakkar.software/starfish-identities": "3.0.0-alpha.21",
    "@drakkar.software/starfish-keyring": "3.0.0-alpha.21",
    "@drakkar.software/starfish-protocol": "3.0.0-alpha.21",
    "@drakkar.software/starfish-sharing": "3.0.0-alpha.21",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.0.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@octochat/tsconfig": "workspace:*",
    "@types/node": "^22.19.19",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
