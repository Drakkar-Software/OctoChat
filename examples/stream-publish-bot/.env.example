# Copy to `.env` (in THIS folder) and fill in. Both implementations read this one
# file: the TS one (`ts/`) auto-loads it (Node ≥20.12); the Python one (`python/`)
# parses it with a tiny built-in loader (no python-dotenv dep).

# Starfish sync server. Default is the local dev server (apps/server on :8787).
# Deployed: https://dev-sync.drakkar.software/sync  (and set the namespace below).
STARFISH_URL=http://localhost:8787

# Bare namespace for a multi-tenant deploy. LEAVE EMPTY for the local dev server
# (it mounts the sync router at root). Deployed OctoChat uses: octochat
STARFISH_NAMESPACE=

# The stream-bot token from the app's "Connect a bot" panel (owner-only, shown on
# a PUBLIC stream room). It's the "Bot link token" field — an audience cap, no
# embedded secret; the bot signs each request with its own generated key.
# NOTE: the audience-cap bot flow is deprecated. For new bots, use webhooks instead.
OCTOCHAT_BOT_TOKEN=

# The "Path to sign" field from the same "Connect a bot" panel, e.g.
# /push/spaces/<spaceId>/streams/pub/<roomId>
OCTOCHAT_BOT_SIGN_PATH=

# OPTIONAL: the message text to publish. Leave empty for a default hello line.
MESSAGE=Hello from the OctoChat publish example 🐙
