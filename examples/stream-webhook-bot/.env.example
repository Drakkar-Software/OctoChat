# Copy to `.env` and fill in. The bot loads this automatically (Node ≥20.12).

# Starfish sync server. Default is the local dev server (apps/server).
# Deployed: https://dev-sync.drakkar.software/sync  (and set the namespace below).
STARFISH_URL=http://localhost:8787

# Bare namespace for a multi-tenant deploy. LEAVE EMPTY for the local dev server
# (it mounts the sync router at root). Deployed OctoChat uses: octochat
STARFISH_NAMESPACE=

# LISTEN credential — a READ-ONLY public-space invite link (the full `…/join#…`
# URL, or just its `#…` fragment). In the app: open a PUBLIC space ▸ share /
# invite ▸ generate a read-only link. `/events` needs a member cap, which this
# link carries; the bot token below is NOT accepted by `/events`.
OCTOCHAT_INVITE_LINK=

# POST credential — the stream-bot token from the app's "Connect a bot" panel.
# NOTE: the audience-cap bot flow is deprecated. For new bots, create a webhook
# URL in the room's settings instead (no token signing required — just POST with
# the webhook token as a header). The fields below are kept for legacy bots only.
OCTOCHAT_BOT_TOKEN=

# The "Path to sign" field, e.g.
# /push/spaces/<spaceId>/streams/pub/<roomId>
OCTOCHAT_BOT_SIGN_PATH=

# OPTIONAL: only react to changes in ONE room. This is a room ID (NOT a link) —
# matched against the changed room's id. Find ids in the bot's own log lines
# ("🔔 activity in <roomId> …"); the default channel is "<spaceId>-general".
# Example: WATCH_ROOM=psp-30773a80ae3226c683dcda227c865046-general
# Leave empty to react to every room in the space.
WATCH_ROOM=

# OPTIONAL loop-guard mode (how the bot avoids reacting to its OWN posts):
#   skip-room   (default) — never react to its own target stream room. Stateless and
#                 unloopable, but it can't react to others' posts in that room.
#   skip-author — on a change in its own target room, pull the new posts and react
#                 only to those NOT authored by the bot. Lets it watch AND post in the
#                 same room. (Trusts the self-declared authorId — see README.)
LOOP_GUARD=skip-room

BOT_NAME=
