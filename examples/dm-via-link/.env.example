# Copy to `.env` (in THIS folder) and fill in. The TS example auto-loads it
# (Node ≥20.12); fall back to exported env vars when there's no `.env`.

# Starfish sync server. Default is the local dev server (apps/server on :8787).
# Deployed: https://dev-sync.drakkar.software/sync  (and set the namespace below).
STARFISH_URL=http://localhost:8787

# Bare namespace for a multi-tenant deploy. LEAVE EMPTY for the local dev server
# (it mounts the sync router at root). Deployed OctoChat uses: octochat
STARFISH_NAMESPACE=

# OPTIONAL: a real user's "DM me" link (the `…/dm#<token>` they shared, or just
# the `#<token>` fragment). Leave EMPTY and the example self-creates a recipient
# identity so it runs end-to-end against a fresh server with zero setup.
DM_LINK=

# OPTIONAL: display names. SENDER is the fresh identity doing the messaging;
# RECIPIENT is only used when DM_LINK is empty (the self-created peer).
SENDER_NAME=Reef Wanderer
RECIPIENT_NAME=Coral Friend
