# Sync server base URL. Defaults to the local dev server.
# STARFISH_URL=http://localhost:8787

# Bare namespace for a deployed server (e.g. "octochat"). Leave empty for local.
# STARFISH_NAMESPACE=

# A "…/join#<token>" space invite link (or bare "#<token>").
# Set this to join a pre-existing OctoDesk space instead of creating a new one.
# Leave empty to have the example create a fresh space automatically.
# SPACE_INVITE_LINK=

# Name of the new space to create (only used when SPACE_INVITE_LINK is empty).
# SPACE_NAME=Drakkar Support

# Display name of the agent / bot identity.
# AGENT_NAME=Support Bot

# Scheme+host used to format the requester invite link URL.
# TICKET_ORIGIN=https://desk.drakkar.software
