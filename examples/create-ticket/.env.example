# Sync server base URL. Defaults to the local dev server.
# STARFISH_URL=http://localhost:8787

# Bare namespace for a deployed server (e.g. "octochat"). Leave empty for local.
# STARFISH_NAMESPACE=

# A "…/join#<token>" space invite link (or bare "#<token>").
# Set this to join a pre-existing OctoDesk space instead of creating a new one.
# Leave empty to have the example create a fresh space automatically.
# SPACE_INVITE_LINK=

# Name of the new space to create (only used when SPACE_INVITE_LINK is empty).
# SPACE_NAME=Drakkar Support

# Display name of the agent / bot identity.
# AGENT_NAME=Support Bot

# Scheme+host used to format the requester invite link URL.
# TICKET_ORIGIN=https://desk.drakkar.software

# ── request.ts (sealed resource-request flow) ──────────────────────────────
# Full "<origin>/request#<token>" identity link printed by a live desk bot
# via myIdentityLink(). Run request.ts once (default mode) to auto-generate
# both BOT_IDENTITY_LINK and REQUESTER_SPACE_ID — they are printed on startup:
#   [req] link    https://desk.drakkar.software/request#eyJ2IjoxL…
#   [req] space   "Drakkar Support" → space-7e4b9c0f…
# Leave empty to auto-create a fresh bot + space each run.
# BOT_IDENTITY_LINK=

# The bot's OctoDesk space id — required when BOT_IDENTITY_LINK is set.
# REQUESTER_SPACE_ID=

# Display name for the auto-created bot identity (default mode only).
# BOT_NAME=Desk Bot

# Display name for the requester identity.
# REQUESTER_NAME=Alice (requester)
