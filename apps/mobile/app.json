{
  "expo": {
    "name": "OctoChat",
    "slug": "octochat",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "octochat",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.drakkarsoftware.octochat",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "oc.drakkar.software",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "oc.drakkar.software",
              "pathPrefix": "/dm"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "buildNumber": "7",
      "bundleIdentifier": "com.drakkarsoftware.octochat",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:oc.drakkar.software"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withFcmChannelReplace",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b151c",
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OctoChat uses Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OctoChat uses the camera to scan device-pairing QR codes."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          },
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "defaultChannel": "messages-v2"
        }
      ],
      "expo-sharing",
      "expo-background-task",
      [
        "@drakkar.software/expo-conductor",
        {
          "enableFcm": false,
          "enableExactAlarms": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "458ea622-202d-484a-bed2-4ad0e63d2068"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/458ea622-202d-484a-bed2-4ad0e63d2068",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}
